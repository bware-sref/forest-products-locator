APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# workaround for Vite bundled asset URLs
ASSET_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# !HEY!
# Keep sqlite uncommented in .env.example so Github test runners work
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# For local development with Laravel Sail, use the DB settings below.
# For local development, DB_HOST should match the DB service name in composer.yaml, e.g., "mysql".
#DB_CONNECTION=mysql
#DB_HOST=mysql
#DB_PORT=3306
#DB_DATABASE=fpn
#DB_USERNAME=sail
#DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DEFAULT_QUEUE=default
IMPORT_QUEUE="${DEFAULT_QUEUE}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# For TrustProxies middleware
# We need this because the proxy handles HTTPS.
# Comma-separated list of IP addresses
# For our purposes, this should match the public IP of Alpha (or the current reverse proxy)
TRUST_PROXIES=

# Xdebug configs
#SAIL_XDEBUG_MODE=develop,debug,coverage

# AWS Location API
AWS_LOCATION_API_BASE_URL=
AWS_LOCATION_API_KEY=

# Rate limits for /api/v1/geocoding/* (per-IP), which pass through to the
# billed-per-request AWS GeoPlaces API. See config/geocoding.php.
GEOCODING_RATE_LIMIT_PER_MINUTE=10
GEOCODING_RATE_LIMIT_PER_DAY=200

# Derived from bounding box of southeastern states
# 107° W to 75° W
# 40° N to 24° N
# more details in config/geocoding.php
GEOCODING_BIAS_POSITION_X=-91.0
GEOCODING_BIAS_POSITION_Y=32.0